use ::core::arch::asm;
#[unsafe(no_mangle)]
pub unsafe extern "C" fn barrier(mut x: *const ::core::ffi::c_void) -> *const ::core::ffi::c_void {
    asm!("\n", "/* {0} */\n", inlateout(reg) x, options(preserves_flags));
    return x;
}
#[unsafe(no_mangle)]
pub unsafe extern "C" fn barrier2(
    mut a: ::core::ffi::c_int,
    mut b: ::core::ffi::c_int,
) -> ::core::ffi::c_int {
    asm!(
        "\n", "/* {0} {1} */\n", inlateout(reg) a, inlateout(reg) b => _,
        options(preserves_flags)
    );
    return a;
}
